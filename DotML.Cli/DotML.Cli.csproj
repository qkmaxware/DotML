<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.0.0</Version>
    <Author>Qkmaxware</Author>
    <Copyright>Copyright (C) 2025 Qkmaxware</Copyright>
    <PackAsTool>true</PackAsTool>
    <AssemblyName>netflow</AssemblyName>
    <ToolCommandName>netflow</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Description>Command line tool for interfacing with Qkmaxware's DotML libraries</Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    
    <!-- dotnet publish -r win-x64 -c Release -->
    <!--<PublishAot>true</PublishAot>-->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Readme.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include=".\src\Docs\*.md" />
    <ProjectReference Include="..\DotML\DotML.csproj" />
    <ProjectReference Include="..\DotML.Netbuild\DotML.Netbuild.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qkmaxware\Terminal\Qkmaxware.Terminal.csproj" />
    <ProjectReference Include="..\DotML.NetDOT\DotML.NetDOT.csproj" />
  </ItemGroup>

</Project>
