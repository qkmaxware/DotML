@page "/utils/safetensors"
@using DotML.Playground.Common.Shared
@using DotML.Playground.Common.Shared.Tools

<TabView @ref=tabs>
    <Tab Title="Home">
        <div class="w3-center" style="vertical-align: top;">
            <button class="tool" @onclick="@(() => { tabs?.Activate(1); })">
                <b>Inspect</b>
                <img src="_content/DotML.Playground.Common/images/inspect.svg">
                <p>

                </p>
            </button>
            <button class="tool" @onclick="@(() => { tabs?.Activate(2); })">
                <b>Compress</b>
                <p>
                    
                </p>
            </button>
        </div>
        <div class="w3-container">
            <p> </p>
        </div>
    </Tab>
    <Tab Title="View">
        <SafetensorViewer></SafetensorViewer>
    </Tab>
    <Tab Title="Compress">
        <SafetensorQuantizer></SafetensorQuantizer>
    </Tab>
</TabView>

@code {
    private TabView? tabs;
}