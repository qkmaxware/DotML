@page "/utils/netbuild"
@using DotML.Playground.Common.Shared
@using DotML.Playground.Common.Shared.Tools

<TabView @ref=tabs>
    <Tab Title="Home">
        <div class="w3-center" style="vertical-align: top;">
            <button class="tool" @onclick="@(() => { tabs?.Activate(1); })">
                <b>Create</b>
                <img src="_content/DotML.Playground.Common/images/page.svg">
                <p>
                    Create a new NetBuild script or modify an existing one. Can create scripts from specific network architectures or from scratch.
                </p>
            </button>
        </div>
        <div class="w3-container">
            <p>
                The above tools are used to create, edit, and inspect NetBuild scripts. A NetBuild script is a declarative script that describes the layers of a neural network architecture for all feed-forward networks architectures.
            </p>
        </div>
    </Tab>
    <Tab Title="Editor">
        <NetbuildBuilder></NetbuildBuilder>
    </Tab>
</TabView>

@code {
    private TabView? tabs;
}