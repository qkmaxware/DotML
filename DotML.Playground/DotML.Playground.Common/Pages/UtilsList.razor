@page "/utils"
@using System.Reflection
@using System.Text.RegularExpressions

<section class="w3-padding">
    @foreach (var subpage in DiscoverPages()) {
        <a class="w3-button w3-card w3-round-xlarge lighter w3-margin-bottom" style="width: 100%; text-align: left;" href="@subpage.Href">
            <h2>@subpage.Name</h2>
            <p>
                Some desc
            </p>
        </a>
    }
</section>

@code {
    private struct Page {
        public string? Name;
        public string? Href;
    }

    private static Regex camelCase = new Regex(@"(?<!^)(?=[A-Z])");

    private IEnumerable<Page> DiscoverPages() {
        var allComponents = typeof(UtilsList)
            .Assembly
            .ExportedTypes
            .Where(t => t.IsSubclassOf(typeof(ComponentBase)));

        var routableComponents = allComponents
            .Where(c => c.GetCustomAttribute<RouteAttribute>(inherit: true) is not null);

        foreach (var component in routableComponents) {
            var route = component.GetCustomAttribute<RouteAttribute>(inherit: true);
            if (route is null)
                continue;

            if (route.Template.StartsWith("/utils/")) {
                yield return new Page {
                    Name = string.Join(' ', camelCase.Split(component.Name)),
                    Href = route.Template.Substring(1)
                };
            }
        }
    }
}    
