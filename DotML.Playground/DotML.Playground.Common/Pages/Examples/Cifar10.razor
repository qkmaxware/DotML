@page "/examples/cifar-10"
@using DotML.Network
@using DotML.Playground.Common.Shared.Interactable

@code {
    const int IMG_WIDTH = 32;
    const int IMG_HEIGHT = 32;
    const int IMG_CHANNELS = 3;
    const int OUT_CLASSES = 10;
    private static string[] OUT_CLASS_NAMES = new string[OUT_CLASSES] {
        "Airplane", "Automobile", "Bird", "Cat", "Deer", "Dog", "Frog", "Horse", "Ship", "Truck"
    };
}

<PageTitle>Fruits</PageTitle>
<ModelRuntime Href="models/cifar-10.model.zip" Context="model">
    <div class="w3-row">
        <div class="w3-half">
            <PaintApp @ref=painter ImgWidth=IMG_WIDTH ImgHeight=IMG_HEIGHT></PaintApp>
        </div>
        <div class="w3-half">
            <ModelRunner Network=@model InputProvider=@GetInput Context="data">
                <table class="w3-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Probability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < OUT_CLASSES; i++) {
                            <tr>
                                <td>@OUT_CLASS_NAMES[i]</td>
                                <td class="w3-display-container">
                                    <div class="w3-round light">
                                        <div class="w3-container w3-round highlight" style="width:@(data.Output[i]*100)%">&nbsp;</div>
                                    </div>
                                    <span class="w3-display-middle">@((data.Output[i]*100).ToString("F2"))%</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ModelRunner>
        </div>
    </div>
</ModelRuntime>

@code {
    private PaintApp? painter;
    
    private static float vectorize(byte b) => b / 255.0f;
    private static Vec<float> vectorize(Pixel[] pixels) {
        float[] values = new float[pixels.Length * 3];
        if (pixels.Length != IMG_WIDTH * IMG_HEIGHT) {
            throw new ArgumentException($"Expected {IMG_WIDTH * IMG_HEIGHT} pixels, got {pixels.Length}.");
        }
        for (var i = 0; i < pixels.Length; i++) {
            values[i + pixels.Length*0] = vectorize(pixels[i].R);
            values[i + pixels.Length*1] = vectorize(pixels[i].G);
            values[i + pixels.Length*2] = vectorize(pixels[i].B);
        }
        return Vec<float>.Wrap(values);
    }
    private async Task<Vec<float>?> GetInput() {
        if (painter is null)
            return null;
        var image = await painter.GetFlattenedPixels();
        var input = vectorize(image);
        return input;
    }
}
