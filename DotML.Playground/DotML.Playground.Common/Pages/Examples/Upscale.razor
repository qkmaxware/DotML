@page "/examples/upscale"
@using DotML.Network
@using DotML.Playground.Common.Shared.Interactable

@code {
    const int IMG_WIDTH = 32;
    const int IMG_HEIGHT = 32;
    const int IMG_CHANNELS = 3;
    const int UPSCALE_FACTOR = 3;
}

<PageTitle>Upscaling</PageTitle>
<ModelRuntime Href="models/espcn-upscale.model.zip" Context="model">
    <div class="w3-row">
        <div class="w3-half">
            <PaintApp @ref=painter ImgWidth=IMG_WIDTH ImgHeight=IMG_HEIGHT></PaintApp>
        </div>
        <div class="w3-half">
            <ModelRunner Network=@model InputProvider=@GetInput Context="data">
                <p class="w3-center">
                    Upscaling from: @model.InputShape &rightarrow; @model.OutputShape
                </p>
                <VectorizedImage Width=@(IMG_WIDTH * UPSCALE_FACTOR) Height=@(IMG_HEIGHT * UPSCALE_FACTOR) ValueScale="255" Vector=@data.Output></VectorizedImage>
            </ModelRunner>
        </div>
    </div>
</ModelRuntime>

@code {
    private PaintApp? painter;
    
    private static double vectorize(byte b) => b / 255.0;
    private static Vec<double> vectorize(Pixel[] pixels) {
        double[] values = new double[pixels.Length * 3];
        if (pixels.Length != IMG_WIDTH * IMG_HEIGHT) {
            throw new ArgumentException($"Expected {IMG_WIDTH * IMG_HEIGHT} pixels, got {pixels.Length}.");
        }
        for (var i = 0; i < pixels.Length; i++) {
            values[i + pixels.Length*0] = vectorize(pixels[i].R);
            values[i + pixels.Length*1] = vectorize(pixels[i].G);
            values[i + pixels.Length*2] = vectorize(pixels[i].B);
        }
        return Vec<double>.Wrap(values);
    }
    private async Task<Vec<double>?> GetInput() {
        if (painter is null)
            return null;
        var image = await painter.GetFlattenedPixels();
        var input = vectorize(image);
        return input;
    }
}
