@page "/examples/or"
@using DotML.Network

<PageTitle>OR</PageTitle>
<ModelRuntime Href="models/or.model.zip">
    <div class="w3-row">
        <div class="w3-third">
            <button class="w3-button w3-block @(isInOn(0) ? ON : OFF)" @onclick=@(() => toggleIn(0))>
                Input 1 - @if (isInOn(0)) {
                    <b>ON</b>
                } else {
                    <b>OFF</b>
                }
            </button>
            <button class="w3-button w3-block @(isInOn(1) ? ON : OFF)" @onclick=@(() => toggleIn(1))>
                Input 2 - @if (isInOn(1)) {
                    <b>ON</b>
                } else {
                    <b>OFF</b>
                }
            </button>
        </div>
        <div class="w3-third">
            <img src="_content/DotML.Playground.Common/images/or.svg" style="width: 100%; height: 4em;" alt="XOR Gate" />
        </div>
        <div class="w3-third">
            <button class="w3-button w3-block @(isOutOn(0, context) ? ON : OFF)" style="line-height: 400%;">
                Output - @if (isOutOn(0, context)) {
                    <b>ON</b>
                } else {
                    <b>OFF</b>
                }
            </button>
        </div>
    </div>
</ModelRuntime>

@code {
    private double[] vector = new double[2] { -1, -1 };
    private Vec<double> input => Vec<double>.Wrap(vector);

    private const string ON = "highlight";
    private const string OFF = "";

    private bool isInOn(int index) {
        return vector[index] > 0;
    }
    private bool isOutOn(int index, FeedforwardNetwork network) {
        return network.PredictSync(input)[index] > 0;
    }
    private void toggleIn(int index) {
        vector[index] = isInOn(index) ? -1 : 1;
    }
}
