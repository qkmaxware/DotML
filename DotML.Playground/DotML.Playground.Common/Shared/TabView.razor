@using Microsoft.AspNetCore.Components
<div class="w3-border">
    <div class="w3-bar w3-border-bottom light">
        @foreach (var tab in Pages) {
            var self_tab = tab; // capture tab
            <button class="w3-bar-item w3-button @(ActivePage == self_tab ? ActiveCss : InactiveCss)" @onclick=@(() => ActivePage = self_tab)>@tab.Title</button>
        }
    </div>
    <div>
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    const string ActiveCss = "highlight";
    const string InactiveCss = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public Tab? ActivePage { get; private set; }
    List<Tab> Pages = new List<Tab>();

    public void Activate(int tab) {
        if (tab < 0 || tab >= Pages.Count) return;
        ActivePage = Pages[tab];
        StateHasChanged();
    }

    internal void AddPage(Tab tabPage) {
        Pages.Add(tabPage);
        if (Pages.Count == 1)
            ActivePage = tabPage;
        StateHasChanged();
    }
}