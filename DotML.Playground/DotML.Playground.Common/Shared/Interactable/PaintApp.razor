@inject IJSRuntime js

<div class="canvas-container">
    <canvas @ref="canvas" width="@ImgWidth" height="@ImgHeight"></canvas>
    <button class="btn delete" @onclick=Clear>&times; Clear</button>
    <div class="transfer @(transferring ? "show" : "hide")">
        transferring data...
    </div>
</div>
<div class="w3-row" style="max-width: 480px; margin-left: auto; margin-right: auto;">
    <div class="w3-col s6">
        <label class="w3-button highlight w3-block">
            <input @ref="import_input" type="file" accept="image/*" capture="environment">
            <img src="_content/DotML.Playground.Common/images/camera.svg" style="height:1em;"/> Upload Photo
        </label>
    </div>
    <div class="w3-col s6">
        <button class="w3-button highlight w3-block" @onclick=Clear>&times; Clear</button>
    </div>
</div>

@code {
    [Parameter] public int ImgWidth {get; set;} = 32;
    [Parameter] public int ImgHeight {get; set;} = 32;
    private ElementReference? canvas;
    private ElementReference? import_input;

    private bool transferring = false;

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender)
            return;

        js.InvokeVoidAsync("BlazorComponents.PaintApp.init", canvas, ImgWidth, ImgHeight, import_input);
    }

    public async void Clear() {
        await js.InvokeVoidAsync("BlazorComponents.PaintApp.clear", canvas);
        await InvokeAsync(StateHasChanged);
    }

    public async Task<Pixel[]> GetFlattenedPixels() {
        var pixels = await getPixelsInChunks();
        return pixels;
    }
    public async Task<IImage> GetImage() {
        var pixels = await GetFlattenedPixels();
        var image = new MemoryImage(ImgWidth, ImgHeight);
        if (image.Pixels is null)
            return image;
        
        var index = 0;
        for (var i = 0; i < ImgHeight; i++) {
            for (var j = 0; j < ImgWidth; j++) {
                image.Pixels[i, j] = pixels[index++];
            }
        }
        return image;
    }
    private async Task<Pixel[]> getPixelsInChunks() {
        transferring = true;
        await InvokeAsync(StateHasChanged);

        const int chunk_size = 360; // 360 pixels * 3 channels = 1080 bytes
        var pixel_values = new Pixel[this.ImgHeight * this.ImgWidth];

        CancellationTokenSource source = new CancellationTokenSource(TimeSpan.FromMinutes(4));
        await js.InvokeVoidAsync("BlazorComponents.PaintApp.cache_pixels", source.Token, canvas, ImgWidth, ImgHeight);
        for (var chunk_start = 0; chunk_start < pixel_values.Length; chunk_start += chunk_size) {
            var pixeldata = await js.InvokeAsync<byte[]>(
                "BlazorComponents.PaintApp.get_chunk_of_cached", 
                source.Token,
                canvas,  
                ImgWidth, 
                ImgHeight,
                chunk_start, 
                chunk_size
            );
            for (int pixel_index = 0, colour_index = 0; colour_index < pixeldata.Length; pixel_index += 1, colour_index+=3) {
                var r = pixeldata[colour_index];
                var g = pixeldata[colour_index + 1];
                var b = pixeldata[colour_index + 2];
                var pixel = new Pixel(r, g, b);
                pixel_values[chunk_start + pixel_index] = pixel;
            }
        }

        transferring = false;
        await InvokeAsync(StateHasChanged);
        
        return pixel_values;
    }
    private async Task<Pixel[]> streamPixels() {
        transferring = true;
        await InvokeAsync(StateHasChanged);

        var tcs = new TaskCompletionSource<Pixel[]>();
        JsStream stream = new JsStream(this.ImgHeight * this.ImgWidth * 3);
        var writer = stream.GetJsWriter();
        stream.OnStreamFlush += (pixeldata) => {
            const int values_per_pixel = 3;
            var pixels = new Pixel[pixeldata.Count / values_per_pixel];

            for (int i = 0, j = 0, n = pixeldata.Count; i < n; i += values_per_pixel, j++) {
                pixels[j] = new Pixel(
                    r: pixeldata[i],
                    g: pixeldata[i + 1],
                    b: pixeldata[i + 2]
                    // Alpha would be i+3
                );
            }

            writer.Dispose();
            tcs.SetResult(pixels);
        };
        CancellationTokenSource source = new CancellationTokenSource(TimeSpan.FromMinutes(4));
        await js.InvokeVoidAsync(
            "BlazorComponents.PaintApp.stream_pixels", 
            source.Token,
            canvas, 
            writer, 
            ImgWidth, 
            ImgHeight
        );
        var px = await tcs.Task;

        transferring = false;
        await InvokeAsync(StateHasChanged);
        
        return px;
    }
    private async Task<Pixel[]> getPixels() {
        transferring = true;
        await InvokeAsync(StateHasChanged);
        
        CancellationTokenSource source = new CancellationTokenSource(TimeSpan.FromMinutes(4));
        var pixeldata = await js.InvokeAsync<byte[]>(
            "BlazorComponents.PaintApp.get_pixels", 
            source.Token,
            canvas,  
            ImgWidth, 
            ImgHeight
        );
        const int values_per_pixel = 3;
        var pixels = new Pixel[pixeldata.Length / values_per_pixel];

        for (int i = 0, j = 0, n = pixeldata.Length; i < n; i += values_per_pixel, j++) {
            pixels[j] = new Pixel(
                r: pixeldata[i],
                g: pixeldata[i + 1],
                b: pixeldata[i + 2]
                // Alpha would be i+3
            );
        }

        transferring = false;
        await InvokeAsync(StateHasChanged);
        
        return pixels;
    }
}