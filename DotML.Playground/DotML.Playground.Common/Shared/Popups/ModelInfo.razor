@using DotML.Network

<Modal @ref=Modal Title="Model Info">
    <table class="w3-table">
        <thead>
            <tr>
                <th>Property</th>
                <th>Value</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Architecture</td>
                <td>@Network?.Name</td>
                <td>The basic structure of the network</td>
            </tr>
            <tr>
                <td>Layer-Count</td>
                <td>@Network?.LayerCount</td>
                <td>The number of layers in the network</td>
            </tr>
            <tr>
                <td>Trainable Parameters</td>
                <td>@Network?.TrainableParameterCount()</td>
                <td>The number of trainable parameters across all layers</td>
            </tr>
            <tr>
                <td>Un-Trainable Parameters</td>
                <td>@Network?.UnTrainableParameterCount()</td>
                <td>The number of un-trainable parameters across all layers</td>
            </tr>
            <tr>
                <td>Storage Size</td>
                <td>@Network?.StorageSize()</td>
                <td>The size of the network as saved on disk</td>
            </tr>
            <tr>
                <td>Input Shape</td>
                <td>@Network?.InputShape</td>
                <td>The allowable size of input tensors</td>
            </tr>
            <tr>
                <td>Output Shape</td>
                <td>@Network?.OutputShape</td>
                <td>The resultant size of output tensors</td>
            </tr>
        </tbody>
    </table>
</Modal>

@code {
    public Modal? Modal {get; set;}
    [Parameter] public FeedforwardNetwork? Network {get; set;}
}    