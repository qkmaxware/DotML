@using DotML.Network

<button class="w3-button w3-block highlight" @onclick=compute>Process</button>
<div class="results">
    <section title="errors" class="w3-margin-top">
    @if (error is not null) {
        <Error Message=@error></Error>
    }
    </section>
    @if (ChildContent is not null && last_output.HasValue) {
        <section title="data">
            @ChildContent((Input: last_input, Output: last_output.Value))
        </section>
    } else {
        <article>
            No input has yet been processed by the model. Press the <b>process</b> button to fetch the model's input and produce it's associated output.
        </article>
    }
    <section title="actions">
        <button class="w3-button w3-block" @onclick=refresh><img src="_content/DotML.Playground.Common/images/refresh.svg" style="height:1em;"/> refresh view</button>
    </section>
    @if (computation is not null) {
        <div class="blocker">
            <Spinner Text="Processing"></Spinner>
        </div>
    }
</div>

@code {
    [Parameter] public FeedforwardNetwork? Network { get; set; }
    [Parameter] public Func<Task<Vec<float>?>>? InputProvider { get; set; }
    [Parameter] public RenderFragment<(Vec<float>? Input, Vec<float> Output)>? ChildContent { get; set; }

    private Vec<float>? last_input;
    private Vec<float>? last_output;

    private Exception? error = null;    
    private Task? computation = null;

    private async Task refresh() {
        await InvokeAsync(StateHasChanged);
    }

    private async void compute() {
        if (computation is not null) {
            return;
        }

        var self_network = Network;
        if (self_network is null) {
            return;
        }

        if (InputProvider is null) {
            return;
        }

        var input = await InputProvider.Invoke();
        last_input = input;
        if (!input.HasValue) {
            return;
        }

        if (input.Value.Dimensionality != self_network.InputShape.Count) {
            error = new Exception($"Input vector has {input.Value.Dimensionality} dimensions, but the model expects {self_network.InputShape.Count}.");
            return;
        }

        error = null;
        computation = Task.Run(async () => {
            try {
                var output = self_network.PredictSync(input.Value);

                last_output = output;
                computation = null;
            } catch (Exception e) {
                error = e;
                computation = null;
            }
            await InvokeAsync(StateHasChanged);
        });
        await InvokeAsync(StateHasChanged);
    }
}