@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime js

<div class="w3-padding">
    <div class="upload">
        @if (original is not null) {
        <table>
            <tbody>
                <tr>
                    <td>Tensors</td><td>@(original.Keys().Count())</td>
                </tr>
                <tr>
                    <td>Size</td><td>@size</td>
                </tr>
            </tbody>
        </table>
        }
        <InputFile OnChange=LoadFile1></InputFile>
    </div>
</div>

<div class="w3-padding w3-center">
    <button class="w3-button highlight" @onclick=quantize_and_download>Quantize and Download</button>
</div>

@code {
    private Safetensors? original;
    private DataSize size;

    private async Task<Safetensors?> LoadFile(InputFileChangeEventArgs e) {
        try {
            var file = e.GetMultipleFiles(1)[0];
            size = DataSize.FromValue(file.Size);
            using var stream = file.OpenReadStream(1_000_000_000);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;
            using var reader = new BinaryReader(memory);
            var set = Safetensors.ReadFrom(reader);
            return set;
        }
        catch (Exception ex) {
            Console.WriteLine(ex);
            return null;
        }
    }

    private async void LoadFile1(InputFileChangeEventArgs e) {
        original = await LoadFile(e);
        await InvokeAsync(StateHasChanged);
    }

    private async void quantize_and_download() {
        if (original is null) {
            return;
        }

        var method1 = new AbsmaxQuantization();
        original.QuantizeAll<double, byte>(method1);
        original.QuantizeAll<float, byte>(method1);

        // TODO Download the quantized file
        using var memory = new MemoryStream();
        using (var writer = new BinaryWriter(memory)) {
            original.WriteTo(writer);
        }

        await js.InvokeVoidAsync(
            "BlazorComponents.Files.download", 
            "quantized.safetensors",  
            "application/octet-stream",
            memory.ToArray()
        );
    }
}