@using DotML
@using DotML.Network.Training
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime js
<header>
@if (loading) {
    <Spinner Text="Loading"></Spinner>
}
else if (set is not null) {
    <table class="w3-table">
        <thead>
            <th></th>
            <th></th>
        </thead>
        <tbody>
            @if (!string.IsNullOrEmpty(fileaname)) {
                <tr>
                    <td>File</td> <td><b>'@(fileaname)'</b></td>
                </tr>
            }
            <tr>
                <td>Data-Type</td> <td>@set.StorageType</td>
            </tr>
            <tr>
                <td>Data-Scaling</td> <td>@set.ScalingFactor</td>
            </tr>
            <tr>
                <td>Training Pairs</td> <td>@set.Count</td>
            </tr>
            <tr>
                <td>Input Size</td> <td>@set.InputLength</td>
            </tr>
            <tr>
                <td>Output Size</td> <td>@set.OutputLength</td>
            </tr>
        </tbody>
    </table>
} else {
    
}
</header>
<div class="w3-padding">
    <div class="load">
        @if (failed_load is not null) {
            <Error Message=failed_load></Error>
        }
        @if (set is null) {
            <text>No training data set loaded. </text>
        } else {
            <text>Load a different training data set. </text>
        }
        <InputFile OnChange=LoadFile></InputFile>
    </div>
</div>
<hr>
<div class="w3-center w3-padding">
@if (set is null) {
    <text>No training data set loaded. </text>
} else {
    <form class="w3-row">
        <label>Training Pair:</label><br>
        <input type="number" min="0" max="@(set.Count-1)" @bind=selected_pair style="max-width: 6em"/> / <input readonly disabled type="number" value="@set.Count" style="max-width: 6em">
    </form>
    <div>
        @{
        KeyValuePair<Array,Array>? pair;
        if ((pair = set.GetPair(selected_pair)).HasValue) {
        <div class="w3-row-padding">
            <div class="w3-half">
                <form>
                    <label>Input Visualization:</label><br>
                    <select @bind=@input_visualization class="w3-input">
                        @foreach (var visualization in Enum.GetValues<TrainingPairVisualizations.Visualization>()) {
                            <option value="@(visualization)">@visualization</option>
                        }
                    </select>
                </form>
                <TrainingPairVisualizations Type=@input_visualization Data=@pair.Value.Key DataScaling=@set.ScalingFactor></TrainingPairVisualizations>
            </div>
            <div class="w3-half">
                <form>
                    <label>Output Visualization:</label><br>
                    <select @bind=@output_visualization class="w3-input">
                        @foreach (var visualization in Enum.GetValues<TrainingPairVisualizations.Visualization>()) {
                            <option value="@(visualization)">@visualization</option>
                        }
                    </select>
                </form>
                <TrainingPairVisualizations Type=@output_visualization Data=@pair.Value.Value DataScaling=@set.ScalingFactor></TrainingPairVisualizations>
            </div>
        </div>
        }}
    </div>
}
</div>

@code {
    private string fileaname = string.Empty;
    private BinaryVectorBuilder? set;
    private int selected_pair = 0;

    private Exception? failed_load = null;
    private bool loading = false;
    private TrainingPairVisualizations.Visualization input_visualization = TrainingPairVisualizations.Visualization.None;
    private TrainingPairVisualizations.Visualization output_visualization = TrainingPairVisualizations.Visualization.None;

    private async Task<(string? FileName, BinaryVectorBuilder Builder)?> TryLoadFile(InputFileChangeEventArgs e) {
        try {
            failed_load = null;
            var file = e.GetMultipleFiles(1)[0];
            using var stream = file.OpenReadStream(100_000_000_000);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;
            using var reader = new BinaryReader(memory);
            BinaryVectorBuilder set = BinaryVectorBuilder.From(reader);
            return (file.Name, set);
        }
        catch (Exception ex) {
            failed_load = ex;
            return null;
        }
    }

    private void LoadFile(InputFileChangeEventArgs e) {
        Task.Run(async () => {
            loading = true;
            await InvokeAsync(StateHasChanged);
            var results = await TryLoadFile(e);
            loading = false;
            if (!results.HasValue) {
                this.fileaname = string.Empty;
                this.set = null;
                await InvokeAsync(StateHasChanged);
                return; 
            }

            this.fileaname = results.Value.FileName ?? string.Empty;
            this.set = results.Value.Builder;
            await InvokeAsync(StateHasChanged);
        });
    }
}