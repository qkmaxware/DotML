    private void make_new() {
        editor?.SetText(string.Empty);
    }
    private void make_from_template() {
        if (editor is null) {
            Console.WriteLine("No editor");
            return;
        }
        var template = template_selected;
        if (template is null) {
            Console.WriteLine("No template");
            return;
        }
        
        var str = template.Factory(template.Arguments);
        if (string.IsNullOrEmpty(str)) {
            Console.WriteLine("No string");
            return;
        }
        editor.SetText(str);

        template_modal?.Hide();
    }

    private Modal? normalize_modal;
    private string? normalization_type = nameof(LayerNorm);
    private Modal? activation_modal;
    private static Regex convo_then_activation = new Regex(@$"^(?<first>\s*ADD\s+{nameof(ConvolutionLayer)}.*)\n(?<second>\s*ADD\s+{nameof(ActivationLayer)}.*)", RegexOptions.Compiled | RegexOptions.Multiline | RegexOptions.IgnoreCase);
    private void InsertNormalization(string? norm_type, string? additional_args) {
        if (norm_type is null) {
            Console.WriteLine("No normalization type provided");
            return;
        }
        RegexReplace(
            convo_then_activation, 
            (match) => $"{match.Groups["first"].Value}\nADD {norm_type} {additional_args}\n{match.Groups["second"].Value}"
        );
    }
    private string? selected_activation_func = null;
    private static Regex activation_only = new Regex(@$"^(?<first>\s*ADD\s+{nameof(ActivationLayer)}.*)", RegexOptions.Compiled | RegexOptions.Multiline | RegexOptions.IgnoreCase);
    private void ChangeActivationFunc(ActivationFunction? func) {
        if (func is null) {
            Console.WriteLine("Activation function missing");
            return;
        }
        using var writer = new StringWriter();
        var s = new DotML.Network.IO.Netbuild.NetbuildLayerEncoder(writer);
        (new ActivationLayer(new Shape3D(), func)).Visit(s);
        writer.Flush();
        var str = writer.ToString().Trim();
        
        RegexReplace(
            activation_only,
            (match) => str
        );
    }
    private void RegexReplace(Regex pattern, MatchEvaluator replacement) {
        var str = editor?.GetText() ?? string.Empty;

        str = pattern.Replace(str, replacement);

        editor?.SetText(str);
    }
}