@using DotML.Network
@using DotML.Network.IO
@using DotML.Playground.Common.Shared.Interactable
@using System.Text.RegularExpressions

<nav class="w3-bar lighter w3-border-bottom">
    <div class="w3-dropdown-hover">
        <button class="w3-button">File</button>
        <div class="w3-dropdown-content w3-bar-block w3-card-4">
            <button class="w3-bar-item w3-button" @onclick=make_new>New</button>
            <button class="w3-bar-item w3-button" @onclick=@(() => template_modal?.Show())>New from Template</button>
            <hr>
            <button class="w3-bar-item w3-button">Save</button>
        </div>
    </div>
    <div class="w3-dropdown-hover">
        <button class="w3-button">Edit</button>
        <div class="w3-dropdown-content w3-bar-block w3-card-4">
            <button class="w3-bar-item w3-button" @onclick=@(() => normalize_modal?.Show())>Insert Normalization</button>
            <button class="w3-bar-item w3-button" @onclick=@(() => activation_modal?.Show())>Change Activation Function</button>
        </div>
    </div>
    <button class="w3-bar-item w3-button w3-right highlight" @onclick=validate>Validate</button>
</nav>
<CodeEditor @ref=editor></CodeEditor>

<Modal Title="Validation" @ref=validation_modal>
    @if (validation_report is null) {
        <Spinner Text="validating"></Spinner>
    } else {
        @if (validation_report.Success) {
            <div class="w3-panel w3-green w3-margin-bottom">
                <h3>&checkmark; Valid!</h3>
                <p>Your netbuild script produces a valid neural network in DotML.</p>
            </div>
            <table class="w3-table">
                <thead>
                    <th>Property</th>
                    <th>Value</th>
                </thead>
                <tbody>
                    <tr>
                        <td>Layers</td><td>@validation_report.layers</td>
                    </tr>
                    <tr>
                        <td>Untrainable Parameters</td><td>@validation_report.untrainable</td>
                    </tr>
                    <tr>
                        <td>Disk Size</td><td>@validation_report.size</td>
                    </tr>
                    <tr>
                        <td>Input Shape</td><td>@validation_report.ishape</td>
                    </tr>
                    <tr>
                        <td>Output Shape</td><td>@validation_report.oshape</td>
                    </tr>
                </tbody>
            </table>
        } else {
            <div class="w3-panel w3-red w3-margin-bottom">
                <h3>&times; Invalid!</h3>
                <p>@validation_report.exception</p>
            </div>
        }
    }
</Modal>

<Modal Title="Template" @ref=template_modal>
    <form>
        <label>Template: </label>
        <select class="w3-select" @bind=template_index>
            <option value="-1">None</option>
            @for (var i = 0; i < templates.Count; i++) {
                var template = templates[i];
                <option value="@i">@template.Name</option>
            }
        </select>
        @if (template_selected is not null) {
        <section class="w3-margin-top w3-margin-bottom">
            <label>Arguments: </label>
            <table class="w3-container w3-table">
                <tbody>
                @foreach (var pair in template_selected.Arguments) {
                    var option = pair.Value;
                    <tr>
                        <td>@(pair.Key):</td><td><input type="@option.HintType" class="w3-input" @bind=option.Value></td>
                    </tr>
                }   
                </tbody>
            </table>
        </section>
        <button type="button" class="w3-button highlight" style="width: 100%" @onclick=make_from_template>Make</button>
        }
    </form>
</Modal>

<Modal Title="Normalization" @ref=normalize_modal>
    <label>Method</label>
    <select @bind=normalization_type class="w3-select">
        <option value="@(nameof(LayerNorm))">Layer Normalization</option>
        <option value="@(nameof(GroupNorm))">Group Normalization</option>
        <option value="@(nameof(BatchNorm))">Batch Normalization</option>
    </select>
    <button type="button" class="w3-button highlight" style="width: 100%" @onclick=@(() => { InsertNormalization(normalization_type, null); normalize_modal?.Hide(); })>Insert</button>
</Modal>

<Modal Title="Activation Function" @ref=activation_modal>
    <label>Functions</label>
    <select class="w3-select" @bind=selected_activation_func>
        <option>None</option>
    @foreach(var func in ActivationFunctions.EnumerateAll()) {
        <option>@func</option>
    }
    </select>
    <button type="button" class="w3-button highlight" style="width: 100%" @onclick=@(() => { ChangeActivationFunc(ActivationFunctions.EnumerateAll().Where(f => f.ToString() == selected_activation_func).FirstOrDefault()); activation_modal?.Hide(); })>Update</button>
</Modal>

@code {

    private Modal? validation_modal;
    private ValidationReport? validation_report;

    private class ValidationReport {
        public bool Success;
        public Exception? exception;

        public DataSize size;
        public int layers;
        public int trainable;
        public int untrainable;
        public Shape3D ishape;
        public Shape3D oshape;
    }
    private void validate() {
        if (editor is null) {
            Console.WriteLine("No editor");
            return;
        }
        var code = editor.GetText();
        var decoder = new NetbuildSerializer();

        validation_report = null;
        validation_modal?.Show();

        Task.Run(async () => {
            try {
                var network = decoder.Deserialize(code);
                var v = new ValidationReport {
                    Success = true,
                    size = network.StorageSize(),
                    layers = network.LayerCount,
                    trainable = network.TrainableParameterCount(),
                    untrainable = network.UnTrainableParameterCount(),
                    ishape = network.InputShape,
                    oshape = network.OutputShape,
                };
                this.validation_report = v;
            } catch (Exception e) {
                var v = new ValidationReport {
                    Success = false,
                    exception = e,
                };
                this.validation_report = v;
            }
            await InvokeAsync(StateHasChanged);
        });
    }

    private class Option {
        public string? Value;
        public string HintType {get; init;}
        public Option(object o) { this.Value = o.ToString(); HintType = "text"; }
        public Option(object o, string hint) { this.Value = o.ToString(); HintType = hint; }

        public string AsString() {
            return Value ?? string.Empty;
        }

        public int AsInt() {
            if (!int.TryParse(Value, out var result)) {
                return 0;
            }
            return result;
        }

        public bool AsBool() {
            if (!bool.TryParse(Value, out var result)) {
                return false;
            }
            return result;
        }

        public float AsFloat() {
            if (!float.TryParse(Value, out var result)) {
                return 0.0f;
            }
            return result;
        }
    }
