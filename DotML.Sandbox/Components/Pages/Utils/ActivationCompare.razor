@page "/util/activation-compare"
@using DotML.Network
@using System.Drawing

<figure>
    <figcaption><h1 style="text-align:center;">Activation Functions</h1></figcaption>
    <div style="display: flex; justify-content: center;">
        <div style="width:90dvw; max-width: 1024px;">
        <Plot XAxis=@domain YAxis=@range SeriesData=@series></Plot>
        </div>
    </div>
    <details open style="margin: 16px;">
        <summary>Legend</summary>
        @for (var i = 0; i < fns.Count; i++) {
            var fn = fns[i];
            var series1 = fx[i];
            var series2 = fxdx[i];

            var c1 = series1.StrokeColour;
            var c2 = series2.StrokeColour;
            
            <div style="display: inline-block; text-align: center; padding: 6px; vertical-align:top">
                <input type="checkbox" checked="@(!ignored.Contains(i))" @onchange=@(e => toggle(e, fn))> @series1.Name
                <p>
                @((MarkupString)fn.ToHtml()) 
                </p>
                f(x)  <div style="display: inline-block; width: 2em; height: 1em; background-color: rgb(@c1.R, @c1.G, @c1.B); border: 1px solid black"></div>
                f'(x) <div style="display: inline-block; width: 2em; height: 1em; background-color: rgb(@c2.R, @c2.G, @c2.B); border: 1px solid black"></div>
            </div>
            
        }
    </details>
</figure>

@code {
    private Plot.Range domain = new Plot.Range (-10, 10);
    private Plot.Range range = new Plot.Range (-1.5, 1.5);

    private List<ActivationFunction> fns = new List<ActivationFunction> {
        Identity.Instance,
        BinaryStep.Instance,
        Sigmoid.Instance,
        HyperbolicTangent.Instance,
        ReLU.Instance,
        LeakyReLU.Instance,
        TeLU.Instance,
    };

    private List<(Color Function, Color Derivative)> fnColours = new List<(Color Function, Color Derivative)> {
        (Color.Black, Color.Gray),
        (Color.Maroon, Color.Red),
        (Color.Green, Color.Lime),
        (Color.Blue, Color.Aqua),
        (Color.Purple, Color.Fuchsia),
        (Color.OrangeRed, Color.Orange),
        (Color.LightCoral, Color.Pink),
    };

    private List<Plot.Series> fx = new List<Plot.Series>();
    private List<Plot.Series> fxdx = new List<Plot.Series>();
    private IEnumerable<Plot.Series> series => 
        fxdx.Where((series, ind) => !ignored.Contains(ind))
          .Concat(fx.Where((series, ind) => !ignored.Contains(ind)));

    private HashSet<int> ignored = new HashSet<int>();
    private void toggle(ChangeEventArgs e, ActivationFunction fn) {
        if ((bool)(e.Value ?? false)) {
            ignored.Remove(fns.IndexOf(fn));
        } else {
            ignored.Add(fns.IndexOf(fn));
        }
    }

    protected override void OnInitialized() {
        for (var i = 0; i < fns.Count; i++) {
            var fn = fns[i];
            var data = new List<(double X, double Y)>();
            var deri = new List<(double X, double Y)>();
            for (double x = domain.Min; x <= domain.Max; x += 0.1) {
                data.Add((x, fn.Invoke(x)));
                deri.Add((x, fn.InvokeDerivative(x)));
            }
            fx.Add(new Plot.Series {
                Name = fn.ToString(),
                Data = data,
                ShowPoints = false,
                ShowStroke = true,
                StrokeColour = fnColours[i].Function
            });
            fxdx.Add(new Plot.Series {
                Name = "d/dx(" + fn.ToString() + ")",
                Data = deri,
                ShowPoints = false,
                ShowStroke = true,
                StrokeColour = fnColours[i].Derivative
            });
        }
    }
}    
