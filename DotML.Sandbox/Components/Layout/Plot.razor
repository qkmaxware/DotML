@using System.Drawing

<svg id="@Id" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 @(GraphWidth + 2 * XOffset) @(GraphHeight + 2 * YOffset + 30)">
    <g id="axes" stroke="gray" fill="gray" text-anchor="end">
        <g id="y-axis">
            @if (SeriesData is not null && SeriesData.Any()) {
            <g id="ticks">
                <text x="40" y="@(YOffset + 15)">@(getRangeMax().ToString("F2"))</text>
                @*<text x="40" y="@(GraphMidpoint + YOffset)">@(getRangeMid().ToString("F3"))</text>*@
                <text x="40" y="@(GraphHeight + YOffset)">@(getRangeMin().ToString("F2"))</text>
            </g>
            }
            <text x="-@(GraphHeight/2)"  y="@YOffset" transform=" rotate(-90)" dominant-baseline="hanging" text-anchor="middle">@YAxisLabel</text>
            <line id="y-axis" stroke="black" x1="@XOffset" x2="@XOffset" y1="@YOffset" y2="@(GraphHeight + YOffset)"/>
        </g>
        <g id="x-axis">
            <text x="@(GraphWidth / 2)" y="@(GraphHeight + 20)" text-anchor="middle">@XAxisLabel</text>
            <line stroke="gray" id="midpoint" x1="@XOffset" x2="@(GraphWidth + XOffset)" y1="@(GraphMidpoint + YOffset)" y2="@(GraphMidpoint + YOffset)"/>
            <line id="x-axis" stroke="black" x1="@XOffset" x2="@(GraphWidth + XOffset)" y1="@(GraphHeight + YOffset)" y2="@(GraphHeight + YOffset)"/>
        </g>
    </g>

    <g id="series">
        @if (this.SeriesData is not null && this.SeriesData.Any()) {
        var series_index = 0;
        var rmax = getRangeMax();
        var rmin = getRangeMin();
        @foreach (var series in this.SeriesData) {
        <g id="series-@(series_index)-@(series.Name)">
            @if (series.Data is not null && series.Data.Any()) {
                @if (series.ShowStroke) {
                <polyline id="trend" stroke="@(hex(series.StrokeColour))" fill="none" points="@PointList(series.Data)"/>
                }
                @if (series.ShowPoints) {
                <g id="points">
                    @foreach(var point in series.Data) {
                        @if (point.Y <= rmax && point.Y >= rmin) {
                        <circle cx="@(XPoint(point.X))" cy="@(YPoint(point.Y))" r="4" fill="@(hex(series.PointColour))">
                            <title>(@(XAxisLabel ?? "x"): @point.X.ToString("F8"), @(YAxisLabel ?? "y"): @point.Y.ToString("F8"))</title>
                        </circle>
                        }
                    }
                </g>
                }
            }
        </g>
        series_index++;
        }
        }
    </g>
</svg>

@code {

    public class Series {
        public string? Name {get; set;}
        public IEnumerable<(double X, double Y)>? Data {get; set;}
        public bool ShowStroke {get; set;} = true;
        public Color StrokeColour {get; set;} = Color.Black;
        public bool ShowPoints {get; set;} = false;
        public Color PointColour {get; set;} = Color.Black;
    }

    [Parameter] public string? Id {get; set;}
    #pragma warning disable BL0007
    [Parameter] public IEnumerable<(double X, double Y)>? Data {
        get => SeriesData?.First().Data;
        set => SeriesData = [
            new Series{
                Name = "Series 1",
                Data = value,
                ShowStroke = true,
                StrokeColour = Color.Black,
                ShowPoints = true,
                PointColour = Color.RoyalBlue
            }
        ];
    }
    #pragma warning restore BL0007

    [Parameter] public IEnumerable<Series>? SeriesData {get; set;}

    [Parameter] public double GraphHeight {get; set;} = 300.0;
    [Parameter] public double GraphWidth {get; set;} = 500.0;
    private const int YOffset = 5;
    private const int XOffset = 50;

    [Parameter] public Range? YAxis {get; set;} = null;
    [Parameter] public string? YAxisLabel {get; set;} = null;
    [Parameter] public Range? XAxis {get; set;} = null;
    [Parameter] public string? XAxisLabel {get; set;} = null;

    private string hex(Color c) => $"#{c.R:X2}{c.G:X2}{c.B:X2}";

    /// <summary>
    /// Represents a range of values
    /// </summary>
    public struct Range {
        /// <summary>
        /// Minimum value range endpoint
        /// </summary>
        public double Min {get; private set;}
        /// <summary>
        /// Maximum value range endpoint
        /// </summary>
        public double Max {get; private set;}
        /// <summary>
        /// Maximum value range endpoint
        /// </summary>
        public double Midpoint => Min + ((Max - Min) / 2.0);
        /// <summary>
        /// Length of the range
        /// </summary>
        public double Length => Max - Min;

        public Range(double a, double b) {
            this.Min = Math.Min(a, b);
            this.Max = Math.Max(a, b);
        }
    }

    private double getRangeMax()  => YAxis.HasValue ? YAxis.Value.Max : (SeriesData is null || !SeriesData.Any() ? 0 : SeriesData.Select(series => series.Data is null || !series.Data.Any() ? 0 : series.Data?.Select(data => data.Y)?.Max() ?? 0).Max());
    private double getRangeMin()  => YAxis.HasValue ? YAxis.Value.Min : (SeriesData is null || !SeriesData.Any() ? 0 : SeriesData.Select(series => series.Data is null || !series.Data.Any() ? 0 : series.Data?.Select(data => data.Y)?.Min() ?? 0).Min());
    private double getRangeMid()  => YAxis.HasValue ? YAxis.Value.Midpoint : (getRangeMin() + (getRangeMax() - getRangeMin())/2);
    private double getRangeLen()  => YAxis.HasValue ? YAxis.Value.Length : (getRangeMax() - getRangeMin());
    private double getDomainMax() => XAxis.HasValue ? XAxis.Value.Max : (SeriesData is null || !SeriesData.Any() ? 0 : SeriesData.Select(series => series.Data is null || !series.Data.Any() ? 0 : series.Data?.Select(data => data.X)?.Max() ?? 0).Max());
    private double getDomainMin() => XAxis.HasValue ? XAxis.Value.Min : (SeriesData is null || !SeriesData.Any() ? 0 : SeriesData.Select(series => series.Data is null || !series.Data.Any() ? 0 : series.Data?.Select(data => data.X)?.Min() ?? 0).Min());
    private double getDomainLen() => getDomainMax() - getDomainMin();

    private double GraphMidpoint => GraphHeight / 2;
    private double XScale() => GraphWidth / getDomainLen();
    private double YScale() => GraphHeight / getRangeLen();

    private string PointList(IEnumerable<(double X, double Y)> series) {
        return string.Join(" ",
            series.Select((point) => $"{XPoint(point.X)},{YPoint(point.Y)}")
        );
    }
    private double XPoint(double x) {
        // Make the x-point relative to the left
        x = x - getDomainMin();
        // Scale to the size of the image
        x = x * XScale();
        // Offset by the axis width
        return XOffset + x;
    }
    private double YPoint(double y) {
        //Console.WriteLine($"y = {y} :: getRangeMax() = {getRangeMax()}; getRangeLen() = {getRangeLen()}; getRangeMax() = {getRangeMax()}, getRangeMin() = {getRangeMin()}; YScale() = {YScale()}");
        // Make relative to top-left
        y = getRangeMax() - y;
        // Scale to the size of the image
        y = y * YScale();
        // Offset if required
        return YOffset + y;
    }
}