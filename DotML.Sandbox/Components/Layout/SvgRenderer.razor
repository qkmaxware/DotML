@inject IJSRuntime js;
<div style="text-align: right;">
    <button type="button" class="btn" style="text-decoration: underline;" @onclick=@(() => download_str())>get</button>
</div>
<figure>
@if (Value is not null) {
    var builder = new StringWriter();
    Value.ToSvg(builder);
    @((MarkupString)builder.ToString())
}
</figure>

@code {
    [Parameter] public IDiagrammable? Value {get; set;}

    private async void download_str(string name = "network.svg") {
        if (Value is null)
            return;
        var builder = new StringWriter();
        Value.ToSvg(builder);
        await js.InvokeVoidAsync("BlazorComponents.Files.download", name, "text/svg", System.Text.Encoding.UTF8.GetBytes(builder.ToString()));
    }
}