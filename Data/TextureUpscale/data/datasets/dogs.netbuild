FROM scratch
INPUT 3 32 32
LABEL "ESPCNx4-Dogs"

ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=2 padding-y=2 filters=128 kernel=5
ADD LayerNorm
ADD ActivationLayer fn=ReLU
ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=1 padding-y=1 filters=64 kernel=3
ADD LayerNorm
ADD ActivationLayer fn=ReLU
ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=1 padding-y=1 filters=48 kernel=3
ADD PixelShuffle upscale-by=4
ADD ActivationLayer fn=HyperbolicTangent
