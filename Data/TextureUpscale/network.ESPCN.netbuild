FROM scratch
INPUT 3 32 32
LABEL "3x-upscale-ESPCN"

ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=2 padding-y=2 filters=64 kernel=5
ADD ActivationLayer fn=ReLU
ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=1 padding-y=1 filters=32 kernel=3
ADD ActivationLayer fn=ReLU
ADD ConvolutionLayer stride-x=1 stride-y=1 padding-x=1 padding-y=1 filters=27 kernel=3
ADD PixelShuffle upscale-by=3
